# Stage A (ayurvedic-predictor) — copy to .env and fill in. Never commit real keys.
# Port contract: 8000
# Approved Stage A stack: Gemini Flash generate + Nemotron 3 Ultra verify (no Claude).

# --- Generator (Stage A interpretation / AI-proposed candidates) -------------
GEMINI_API_KEY=
# GENERATOR_MODEL=gemini-3.5-flash
# Falls back automatically: gemini-3.8-flash → 3.5 → 2.5 → 2.0
# GENERATOR_MODEL_FALLBACKS=gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-2.0-flash

# --- Claim verifier (cross-provider vs Gemini) -------------------------------
# NVIDIA Nemotron 3 Ultra (default). Super only if Ultra unavailable on the key.
NVIDIA_API_KEY=
# NIM_API_KEY=                      # alias for NVIDIA_API_KEY
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
# NIM_MODEL_FALLBACK=nvidia/llama-3.3-nemotron-super-49b-v1
# VERIFIER_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
#
# Claude escalate is OFF for this Stage A version (set A_CLAUDE_ESCALATE=1 to opt in):
# A_CLAUDE_ESCALATE=0
# ANTHROPIC_API_KEY=
# ESCALATE_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Prefer blue adjudication when reachable (falls back to local NIM→Gemini cascade):
# ADJUDICATION_URL=http://127.0.0.1:8011
# ADJUDICATION_PREFERRED=1
# ADJUDICATION_TIMEOUT_S=8

# NCBI_API_KEY=
# NCBI_EMAIL=research@herbenzo.example

# Shared PubMed/PMID cache with Stage B / adjudication (Task T16):
# HERBENZO_PUBMED_CACHE_DIR=/Users/shivasaimomula/Desktop/herbenzo_shared_cache/pubmed
# HERBENZO_PUBMED_CACHE_TTL_S=2592000

# Optional listen port (run.sh / uvicorn default 8000):
# PORT=8000

# Async predict jobs (Task T18 / Finding #20):
# PREDICT_JOB_TIMEOUT_S=540
# PREDICT_MAX_CONCURRENT_JOBS=2
# PREDICT_JOB_RETENTION_S=3600

# A → C FormulationInput demo defaults (optional handoff — A solo does not require these)
# FORMULATION_TARGET_MARKET=US
# FORMULATION_PRODUCT_CATEGORY=dietary_supplement
# FORMULATION_REGULATORY_CATEGORY=SUPPLEMENT
# FORMULATION_DOSAGE_FORM=
# FORMULATION_SERVING_SIZE_G=
# ENUM_STRICT=0

# A → B FormulationSpec: optional; null + error does not block A recommendation UI.
# FORMULATION_SPEC_ALLOW_DEMO_DOSES=1
