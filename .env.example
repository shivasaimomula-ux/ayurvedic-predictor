# Copy to .env and fill in. Never commit real keys.

# --- Generator (Stage A interpretation / proposal) ---------------------------
GEMINI_API_KEY=
# GENERATOR_MODEL=gemini-2.5-flash

# --- Claim verifier cost order (Audit #11 / Task T15) -----------------------
# NVIDIA (NIM) > Gemini > Claude. Claude is escalate-only (disagreement /
# hard-reject), NEVER the default high-volume verifier.
#
# Optional NIM (cheapest LLM when key is set):
# NVIDIA_API_KEY=
# NIM_API_KEY=                      # alias for NVIDIA_API_KEY
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_MODEL=meta/llama-3.1-70b-instruct
#
# Cheap verifier default (Gemini — not Claude):
# VERIFIER_MODEL=gemini-2.5-pro
#
# Claude only for escalate on cheap-provider disagreement / hard-reject:
# ANTHROPIC_API_KEY=
# ESCALATE_MODEL=claude-sonnet-4-6

# Prefer blue adjudication service when reachable (falls back to local cascade):
# ADJUDICATION_URL=http://127.0.0.1:8011
# ADJUDICATION_PREFERRED=1
# ADJUDICATION_TIMEOUT_S=8

# NCBI_API_KEY=
# NCBI_EMAIL=research@herbenzo.example

