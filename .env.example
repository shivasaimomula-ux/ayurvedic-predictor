# Copy to .env and fill in. Never commit real keys.
GEMINI_API_KEY=
# Optional: preferred verifier when set (Claude only for trust-critical verify).
ANTHROPIC_API_KEY=
# GENERATOR_MODEL=gemini-2.5-flash
# VERIFIER_MODEL=claude-sonnet-4-6
# NCBI_API_KEY=
# NCBI_EMAIL=research@herbenzo.example

# A → C FormulationInput demo defaults (modernized_sku stays null until B runs)
# FORMULATION_TARGET_MARKET=US
# FORMULATION_PRODUCT_CATEGORY=dietary_supplement
# FORMULATION_REGULATORY_CATEGORY=SUPPLEMENT
# FORMULATION_DOSAGE_FORM=
# FORMULATION_SERVING_SIZE_G=
# ENUM_STRICT=0

# A → B FormulationSpec: use CoA/demo quantity_mg table when stated dose absent.
# Set to 0 to refuse FormulationSpec unless each herb has an explicit positive dose.
# FORMULATION_SPEC_ALLOW_DEMO_DOSES=1
